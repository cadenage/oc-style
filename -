:root {
  --header-border-color: #ececec;
  /*nav*/
  --nav-link-color: #393939;
  /*button colors*/
  --button-primary-bg: #282c35;
  --button-secondary-bg: #f3f9fa;
  --button-secondary-border-color: #d4d7e3;
  --button-border-radius: .75rem;
  /*footer*/
  --footer-border-color: rgba(255, 255, 255, 0.16);
}

a:focus,
button:focus,
input:focus,
select:focus,
textarea:focus {
  outline: none;
}
a:focus-visible,
button:focus-visible,
input:focus-visible,
select:focus-visible,
textarea:focus-visible {
  outline: 0.13rem solid #0b57d0;
  outline-offset: 0.13rem;
}
@media (forced-colors: active) {
  a:focus-visible,
  button:focus-visible,
  input:focus-visible,
  select:focus-visible,
  textarea:focus-visible {
    outline: 0.13rem solid CanvasText;
  }
}

h1 {
  font-family: "Roboto Slab", serif;
  font-size: 3rem;
  font-weight: 700;
}
@media screen and (min-width: 768px) {
  h1 {
    font-size: 3.75rem;
  }
}

h2 {
  font-family: "Roboto Slab", serif;
  font-size: 2.5rem;
  font-weight: 700;
  line-height: 1.6;
}
@media screen and (min-width: 768px) {
  h2 {
    font-size: 3.125rem;
  }
}

h3 {
  font-family: "Roboto Slab", serif;
  font-size: 1.5rem;
  font-weight: 600;
  line-height: 1.6;
}
@media screen and (min-width: 768px) {
  h3 {
    font-size: 2rem;
  }
}

.eyebrow {
  color: #036F54 !important;
  font-family: "Roboto Slab", serif;
  font-size: 1rem;
  font-weight: 700;
  letter-spacing: 0.09rem;
  padding-bottom: 0.5rem;
  position: relative;
  text-align: center;
  text-transform: uppercase;
}
@media screen and (min-width: 768px) {
  .eyebrow {
    font-size: 1.125rem;
  }
}
.eyebrow:after {
  content: "";
  background-color: #ffc619;
  display: block;
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 4rem;
  height: 3px;
}

.oc-card {
  border: 1px solid #dce2ee;
  border-radius: 0.75rem;
  padding: 1.5rem 1rem;
}
@media screen and (min-width: 768px) {
  .oc-card {
    padding: 2rem 1.5rem;
  }
}
.oc-card {
  background-color: #f5f7fe;
}

.primary-button:focus {
  outline: none;
}
.primary-button:focus-visible {
  outline: 0.13rem solid #0b57d0;
  outline-offset: 0.13rem;
}
@media (forced-colors: active) {
  .primary-button:focus-visible {
    outline: 0.13rem solid CanvasText;
  }
}
.primary-button {
  border-radius: 0.75rem;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1px solid transparent;
  font-size: 0.875rem;
  font-weight: 600;
  padding: 0.625rem 1rem;
  text-decoration: none;
}
@media screen and (min-width: 1024px) {
  .primary-button {
    font-size: 1rem;
    padding: 1rem 1.5rem;
  }
}
.primary-button {
  background-color: #282c35;
  color: #ffffff;
}
.primary-button:hover, .primary-button:focus {
  background-color: #4D545E;
}

.secondary-button:focus {
  outline: none;
}
.secondary-button:focus-visible {
  outline: 0.13rem solid #0b57d0;
  outline-offset: 0.13rem;
}
@media (forced-colors: active) {
  .secondary-button:focus-visible {
    outline: 0.13rem solid CanvasText;
  }
}
.secondary-button {
  border-radius: 0.75rem;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1px solid transparent;
  font-size: 0.875rem;
  font-weight: 600;
  padding: 0.625rem 1rem;
  text-decoration: none;
}
@media screen and (min-width: 1024px) {
  .secondary-button {
    font-size: 1rem;
    padding: 1rem 1.5rem;
  }
}
.secondary-button {
  background-color: #f3f9fa;
  color: #036f54;
  border-color: #d4d7e3;
}
.secondary-button:hover, .secondary-button:focus {
  background-color: #f9fafb;
  border-color: #9ca3af;
}
